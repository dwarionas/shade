{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExamShade",
  "version": "0.1.0",
  "identifier": "com.examshade.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ExamShade",
        "width": 540,
        "height": 420,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
